# triops runtime state — never commit
app/config.php
app/data/*
!app/data/.htaccess
!app/data/index.php

# build output — releases are attached to GitHub Releases, not committed
dist/

# local agent scratch — AGENTS.md is the committed copy of these conventions,
# and three vendor-specific copies of the same rules drift and then contradict
# each other. Keep a CLAUDE.md locally if your tooling looks for that name.
CLAUDE.md

# editors / os
*~
*.log
.DS_Store

# node (dev tooling only, never at runtime)
node_modules
coverage
.nyc_output
*.tgz

# dev tooling (playwright); never ships
dev/node_modules
dev/package-lock.json
